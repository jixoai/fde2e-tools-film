{
  "name": "openfilm",
  "version": "0.2.7",
  "description": "The film format (film.html / window.film) and Studio, the editor. Web edition of OpenFilm (MIT) for fde2e.",
  "license": "MIT",
  "homepage": "https://github.com/jixoai/fde2e-tools-film",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jixoai/fde2e-tools-film.git",
    "directory": "packages/openfilm"
  },
  "keywords": [
    "video",
    "motion-graphics",
    "agents",
    "claude-code",
    "codex",
    "animation",
    "render"
  ],
  "type": "module",
  "exports": {
    "./film-doc": "./src/film-doc.mjs",
    "./host": "./src/host.mjs",
    "./shared": "./src/shared.mjs",
    "./look": "./src/look.mjs",
    "./render": "./src/render.mjs",
    "./problems": "./src/problems.mjs",
    "./skills": "./src/skills.mjs",
    "./studio": "./studio/server/server.mjs",
    "./studio-ui/*": "./studio/ui/src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "SPEC.md",
    "src",
    "!src/*.test.mjs",
    "MANUAL.md",
    "studio/server/**/*.mjs",
    "studio/server/**/*.js",
    "!studio/server/**/*.test.mjs",
    "studio/client.mjs",
    "studio/ui/dist",
    "THIRD_PARTY_NOTICES.md",
    "product.json"
  ],
  "engines": {
    "node": ">=22.2"
  },
  "dependencies": {
    "playwright-core": "1.61.1",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=300000 src/*.test.mjs studio/*.test.mjs studio/server/*.test.mjs studio/server/providers/*.test.mjs studio/ui/src/editor/*.test.ts studio/ui/src/lib/*.test.ts studio/ui/src/components/*.test.ts",
    "typecheck": "tsc -p studio/server && tsc -p studio/ui",
    "build:ui": "node studio/ui/scripts/emit-film-runtime.mjs && vite build --config studio/ui/vite.config.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^0.469.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "tw-animate-css": "^1.4.0"
  }
}
